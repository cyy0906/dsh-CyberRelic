      "message",
      "draft"
    ],
    "capabilities": [
      "audio"
    ],
    "contributes": {
      "composer.actions": [
        {
          "id": "read-latest",
          "label": {
            "zh": "读最新回复",
            "en": "Read last"
          },
          "icon": "speaker",
          "requires": [
            "audio"
          ]
        },
        {
          "id": "read-draft",
          "label": {
            "zh": "朗读输入框",
            "en": "Read draft"
          },
          "icon": "speaker",
          "requires": [
            "audio"
          ]
        }
      ],
      "message.actions": [
        {
          "id": "read-message",
          "label": {
            "zh": "朗读",
            "en": "Read aloud"
          },
          "icon": "speaker",
          "requires": [
            "audio"
          ]
        }
      ],
      "media": [
        {
          "id": "speech"
        }
      ]
    }
  }
}
